{
  "name": "class-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "db:push": "tsx scripts/db-push.ts",
    "drive": "tsx scripts/drive.ts",
    "wa": "tsx scripts/wa-cloud.ts",
    "probe": "tsx scripts/probe-model.ts",
    "probe:sql": "tsx scripts/probe-sql.ts",
    "drive:week": "tsx scripts/drive-week.ts",
    "ask": "tsx scripts/probe-ask.ts",
    "surface": "tsx scripts/probe-surface.ts",
    "guards": "tsx scripts/guard-value.ts",
    "check:world": "tsx scripts/check-world.ts",
    "check:schema-doc": "tsx scripts/check-schema-doc.ts",
    "check:rls-doc": "tsx scripts/check-rls-doc.ts",
    "check:clash": "tsx scripts/check-clash.ts",
    "check:layout": "tsx scripts/check-layout.ts",
    "check:findings": "tsx scripts/check-findings.ts",
