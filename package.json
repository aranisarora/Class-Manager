  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
